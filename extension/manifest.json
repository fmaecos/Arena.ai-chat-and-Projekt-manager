{
  "manifest_version": 3,
  "name": "Kontext — Archiv-Agent",
  "description": "Öffnet den Kontext-Sprachassistenten für Archivläufe in einem freigegebenen Chrome-Tab.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "sidePanel", "activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:17654/*", "https://chatgpt.com/*", "https://chat.openai.com/*",
    "https://claude.ai/*", "https://gemini.google.com/*", "https://arena.ai/*", "https://lmarena.ai/*"
  ],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Kontext Archiv-Agent öffnen", "default_icon": "icons/32.png" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://arena.ai/*", "https://lmarena.ai/*"],
    "js": ["adapters.js", "content.js"], "run_at": "document_idle"
  }]
}
